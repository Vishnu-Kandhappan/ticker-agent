# Optional: configure an Incoming Webhook URL to post the briefing to Slack
SLACK_WEBHOOK_URL=

# Optional settings
PORTFOLIO_PATH=config/portfolio.json
NEWS_RESULTS_PER_ASSET=3
REPORT_ARTIFACTS_DIR=artifacts
NEWS_MIN_REQUEST_INTERVAL_SECONDS=2
NEWS_MAX_RETRIES=3

# Local Ollama inference for the catalyst analyst
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=gemma3:4b
LOCAL_LLM_TIMEOUT_SECONDS=90

# OpenTelemetry (docs/observability.md). Traces: console | otlp | none.
OTEL_TRACES_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=financial-alert
# ticker-review.py reports as its own service
TICKER_REVIEW_SERVICE_NAME=ticker-review
# Metrics: console | otlp | none (default: otlp when traces use otlp)
# OTEL_METRICS_EXPORTER=otlp
# OTEL_METRIC_EXPORT_INTERVAL=15000
# Auth for hosted backends, e.g. Langfuse: Authorization=Basic <base64 public_key:secret_key>
# OTEL_EXPORTER_OTLP_HEADERS=
# Record prompts and model responses on spans (off by default)
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Ticker review crawler (config/crawler-rules.md)
MAX_NEWS_ITEMS=2
CRAWLER_SLEEP_MS=1500
SAFE_SEARCH=true
CRAWLER_TIMEOUT_MS=20000
